# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to git (it is in .gitignore).

OPENAI_API_KEY=sk-...

# Upstash Vector: REST credentials from YOUR index in the Upstash console.
# Create the index with: Dimensions 1536, Metric COSINE, no embedding model.
UPSTASH_VECTOR_REST_URL=https://...-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=...

# Optional tuning knobs (Phase 5). Defaults shown.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=6
# OPENAI_MODEL=gpt-4o-mini
